# ─── Here For YOU — environment variables ───────────────────────────────────
# Local: copy to .env.local.  Production: add each one in Vercel → Settings →
# Environment Variables.  NEVER commit .env.local.  See README.md for where to get each.

# Public URL of the app (no trailing slash). Locally: http://localhost:3000
APP_URL=https://here-for-you.vercel.app

# ── Firebase (project "Here For YOU", free Spark plan) ──
# Web app config: Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account: Project settings → Service accounts → Generate new private key,
# then: base64 -i service-account.json | tr -d '\n'   (paste the single line here)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Gemini (Google AI Studio → Get API key) ──
GEMINI_API_KEY=
# Copy the current Flash model id shown in AI Studio
GEMINI_MODEL=

# ── Gmail sender (dedicated account, 2-Step Verification ON → App passwords) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Upstash QStash (console.upstash.com → QStash → Signing keys) ──
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Vercel Cron secret (any random 32+ chars: openssl rand -hex 24) ──
CRON_SECRET=

# ── Passkeys (WebAuthn) — must match the site's host exactly, no protocol ──
# Local: localhost   Production: here-for-you.vercel.app
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Here For YOU
